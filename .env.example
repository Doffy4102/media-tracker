DATABASE_URL="postgresql://user:password@host:5432/media_tracker"
TMDB_API_KEY="your_tmdb_api_key"
AUTH_SECRET="your_32_byte_hex_secret"
GOOGLE_BOOKS_API_KEY="your_google_books_api_key_optional"
RAWG_API_KEY="your_rawg_api_key"
IGDB_CLIENT_ID="your_twitch_app_client_id"
IGDB_CLIENT_SECRET="your_twitch_app_client_secret"
MAL_CLIENT_ID="your_mal_client_id"

# Google sign-in (OAuth client of type "Web app"; redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback)
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# SMTP (for password reset emails)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_email@example.com"
SMTP_PASS="your_email_password"
SMTP_FROM="Media Shelf <noreply@example.com>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Daily FMHY stream-sites refresh (Vercel Cron sends this as "Authorization: Bearer $CRON_SECRET")
CRON_SECRET="your_random_cron_secret"
